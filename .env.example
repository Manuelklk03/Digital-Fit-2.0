# ===================================================================
# Digital-Fit 2.0 — Plantilla de Variables de Entorno (.env.example)
# ===================================================================
# Copia este archivo como .env en la raíz del repositorio y personaliza
# los valores (.env está en .gitignore y nunca debe versionarse).
# Valores ficticios documentados para dev, staging y prod.

# Perfil activo de Spring Boot (dev | staging | prod)
SPRING_PROFILES_ACTIVE=dev

# Conexión a Base de Datos PostgreSQL 17
# Dev (local):
DB_URL=jdbc:postgresql://localhost:5433/digital_fit
DB_USERNAME=digitalfit
DB_PASSWORD=digitalfit_dev_password
DB_PORT=5433

# Staging (Neon branch staging / Render):
# DB_URL=jdbc:postgresql://ep-staging-example.eu-central-1.aws.neon.tech/digital_fit_staging?sslmode=require
# DB_USERNAME=digitalfit_staging_user
# DB_PASSWORD=staging_secure_password_example

# Prod (Neon branch main / Render):
# DB_URL=jdbc:postgresql://ep-prod-example.eu-central-1.aws.neon.tech/digital_fit?sslmode=require
# DB_USERNAME=digitalfit_prod_user
# DB_PASSWORD=prod_secure_password_example

# Puertos expuestos para Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Seguridad de cookies de sesión (D2, P2)
# En dev sobre HTTP debe ser false; en staging y prod sobre HTTPS debe ser true
SESSION_COOKIE_SECURE=false

# Orígenes permitidos para CORS (P3)
# Dev: http://localhost:4200
# Staging: https://staging--digitalfit.netlify.app
# Prod: https://digitalfit.example.com,https://digitalfit.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:4200
